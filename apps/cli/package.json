{
	"name": "@tripwire-sh/cli",
	"version": "0.1.0",
	"description": "Set up Tripwire in your coding agents and manage it from the terminal",
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Boring-Software-Inc/v2.git",
		"directory": "apps/cli"
	},
	"homepage": "https://tripwire.sh",
	"bin": {
		"tripwire": "dist/tripwire.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20.12"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun build src/index.ts --target node --format esm --minify --outfile dist/tripwire.js",
		"typecheck": "tsrs --noEmit --checkers 4 --fast false",
		"typecheck:ts5": "tsc --noEmit"
	},
	"devDependencies": {
		"@clack/prompts": "^1.7.0",
		"@modelcontextprotocol/sdk": "^1.32.1",
		"@tripwire/contracts": "workspace:*",
		"commander": "^14.0.3",
		"jsonc-parser": "^3.3.1",
		"picocolors": "^1.1.1",
		"yaml": "^2.9.0",
		"zod": "^4.0.0"
	}
}
