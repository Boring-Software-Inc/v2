// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`renderCommentBody — snapshot golden files blocked (mixed remedies, wait-hint inline) 1`] = `
"@octocat, Tripwire blocked this from merging.

Your account is 2 days old. This clears in 5 days.

It adds 2 crypto wallet addresses to DONATE.md.

<a href="https://tripwire.sh/runs/0198abcd"><img src="https://tripwire.sh/badges/view-run.png" width="185" alt="View on Tripwire" /></a>

<details><summary>How do I fix this?</summary>

Fix what you can, then push a new commit. Tripwire checks this again after every push. Some of these problems will not go away with a new commit.

If you think this should merge anyway, say so in a comment here. A maintainer will decide.
</details>

<details><summary>What is Tripwire?</summary>

Tripwire checks contributions to this repository. The maintainers set rules that every change must pass before it can merge, such as rules about account age, how often you open change requests, and hidden links. Members of the organization skip these checks.

The Tripwire page for this check shows every rule it applied, what it found, and the result.
</details>
<!-- tripwire:run -->
"
`;

